[llm]
# OpenAI 兼容接口地址(硅基流动 SiliconFlow)
base_url = https://api.siliconflow.cn/v1
# 在此填入你的 SiliconFlow API Key(控制台 → API 密钥)
api_key = your-api-key-here
# 模型名称(按 https://api-docs.siliconflow.com 文档填写)
model = Qwen/Qwen3.5-4B
# 是否开启思考模式;false = 跳过思考直接出回答(首字快),true = 先输出思考过程
enable_thinking = false
# 打字机逐字延时(秒);设为 0 关闭延时立即输出
typewriter_delay = 0.01
# 请求超时(秒)
timeout = 60
